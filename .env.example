# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (Server-side only, DO NOT expose to client)
# Required for E2E test user creation
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Google Calendar Integration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional: override the webhook address passed to Google watch API.
# - Required if you want Google → Taesk card updates in local dev (use a tunnel like ngrok).
# - Must be an absolute URL ending with `/api/integrations/google-calendar/webhook`
GOOGLE_CALENDAR_WEBHOOK_URL=https://your-public-domain.example/api/integrations/google-calendar/webhook

# E2E Testing Configuration
# Enable E2E test endpoints (/api/e2e/ APIs)
E2E_ENABLED=true
# Secret key for E2E API access (must match in test environment)
E2E_SECRET=your-e2e-secret-key
# Test user credentials (created automatically by globalSetup)
E2E_USER_EMAIL=e2e-test@taesk.app
E2E_USER_PASSWORD=replace-with-local-test-password

# Phase 3: Feature Flags
NEXT_PUBLIC_FF_BOARD_PERMISSIONS=true
NEXT_PUBLIC_FF_COMMENTS=true
NEXT_PUBLIC_FF_NOTIFICATIONS=true
NEXT_PUBLIC_FF_PUSH=true

# Debug: enable Timeline polling fallback (every 10s) when Realtime is not connected.
# Keep false by default to avoid masking Realtime/Webhook bugs.
NEXT_PUBLIC_ENABLE_TIMELINE_POLLING=false

# Debug: log Realtime postgres_changes bindings in browser console.
NEXT_PUBLIC_DEBUG_REALTIME=false

# Web Push (VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
