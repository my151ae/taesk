# Supabase test project
NEXT_PUBLIC_SUPABASE_URL=https://your-test-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-test-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# E2E test endpoints
E2E_ENABLED=true
E2E_SECRET=replace-with-a-local-random-e2e-secret
E2E_USER_EMAIL=e2e-test@example.com
E2E_USER_PASSWORD=replace-with-a-local-test-password

# Optional integrations for focused tests
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
